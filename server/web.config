<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================
    MI ARCUS — IIS REQUEST SIZE / TIMEOUT CONFIG
    ============================================================

    WHY THIS FILE EXISTS
    ---------------------
    client/src/axiosConfig.js documents the real production path for
    this app:

        https://rytual2.miarcus.com/api/*
                       |
                       v  (IIS reverse proxy)
        http://127.0.0.1:5000/api/*

    IIS's OWN default request-size limit (maxAllowedContentLength) is
    30,000,000 bytes — about 28.6 MB. That limit is enforced by IIS
    itself, BEFORE the request ever reaches the Node/Express app on
    127.0.0.1:5000. A Checklist Reports bulk-upload file under ~28 MB
    sails through; a bigger one (a large historical export — the kind
    of file this app is now expected to import, given it needs to
    support 100,000 / 1,000,000+ rows) is rejected by IIS with
    "413 Request Entity Too Large" before Express's own body size
    guards, multer's fileSize limit, or any application code ever runs.
    That is why bulk upload looked "random" — it actually depended
    entirely on which file's size happened to be uploaded, not on
    chance.

    Every application-level limit already covers large files:
      - server/middleware/bulkFileUpload.js  -> multer fileSize: 500 MB
      - server/routes/checklistReportRoutes.js -> 15-minute request
        timeout on the bulk-upload route
      - server/middleware/requestSecurity.js's contentTypeGuard already
        exempts multipart/form-data uploads from its own 10 MB check

    IIS's own ceiling is the one piece that lives outside this Node
    project entirely (IIS reads it from web.config / applicationHost.config,
    not from anything Node/Express does), so it has to be raised here.

    HOW TO APPLY THIS
    -------------------
    1. This file needs to live in the IIS SITE ROOT that terminates
       https://rytual2.miarcus.com and reverse-proxies /api/* to
       127.0.0.1:5000 (via URL Rewrite / Application Request Routing).
       That site almost certainly already has its own web.config with
       the URL Rewrite rules in it — if so, do NOT just drop this file
       on top of it. Instead, copy the <system.webServer> content below
       into the EXISTING web.config (merge the <security> and
       <serverRuntime>/<httpProtocol> blocks in; keep the existing
       <rewrite> rules as they are).
    2. If that IIS site has no web.config yet (e.g. it is a bare
       reverse-proxy site), this file can be used as-is.
    3. After saving, either recycle the site's Application Pool or run
       `iisreset` for the new limits to take effect.
    4. If Application Request Routing (ARR) is used as a server-wide
       proxy (rather than per-site URL Rewrite rules), ARR also has its
       own separate content-length limit under IIS Manager ->
       Application Request Routing Cache -> Server Proxy Settings ->
       "Maximum server response content buffer size" / (on older IIS,
       a "maxAllowedContentLength" set on the ARR proxy module itself).
       If uploads still fail after step 1-3, raise that limit too, and
       also check "Response Buffering Threshold" / proxy timeout there
       (bump the proxy timeout to match the 15-minute value the Node
       route now allows).
-->
<configuration>
    <system.webServer>

        <!-- ==================================================
             REQUEST SIZE LIMIT
             Default is 30,000,000 bytes (~28.6 MB). Raised to
             524,288,000 bytes (500 MB) to match the multer
             fileSize limit in server/middleware/bulkFileUpload.js.
        =================================================== -->
        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="524288000" />
            </requestFiltering>
        </security>

        <!-- ==================================================
             UPLOAD READ-AHEAD SIZE
             Governs how much of the request body IIS buffers
             before handing it to the module doing the proxying.
             The IIS default here (49152 bytes / 48 KB) is far
             smaller than a real bulk-upload file — raised well
             above the request size limit above so it never
             becomes a second, smaller ceiling.
        =================================================== -->
        <serverRuntime uploadReadAheadSize="524288000" />

        <!-- ==================================================
             REQUEST TIMEOUT
             Matches the 15-minute timeout set on the bulk-upload
             route in server/routes/checklistReportRoutes.js, so
             IIS does not cut the connection to 127.0.0.1:5000
             before Node itself is done processing a very large
             file.
        =================================================== -->
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
            </customHeaders>
        </httpProtocol>

    </system.webServer>
</configuration>
