# ======================================================
# DEPENDENCIES
# ======================================================

node_modules/
**/node_modules/

client/node_modules/
server/node_modules/


# ======================================================
# ENVIRONMENT VARIABLES / SECRETS
# ======================================================

# Never commit real environment files
.env
.env.*
**/.env
**/.env.*

/server/.env
/server/.env.*
/client/.env
/client/.env.*

.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow safe example/template files
!.env.example
!**/.env.example


# ======================================================
# GOOGLE OAUTH CREDENTIALS / TOKENS
# NEVER COMMIT THESE FILES
# ======================================================

# OAuth client credentials
credentials.json
**/credentials.json

client_secret*.json
**/client_secret*.json

client-secret*.json
**/client-secret*.json

oauth*.json
**/oauth*.json

oauth2*.json
**/oauth2*.json

# OAuth tokens
gmail-token.json
**/gmail-token.json

token.json
**/token.json

tokens.json
**/tokens.json

token*.json
**/token*.json

# Google authentication files
google-credentials.json
**/google-credentials.json

google-token.json
**/google-token.json

google-oauth*.json
**/google-oauth*.json


# ======================================================
# GOOGLE SERVICE ACCOUNT / PRIVATE KEYS
# NEVER COMMIT THESE FILES
# ======================================================

service-account*.json
**/service-account*.json

service_account*.json
**/service_account*.json

*-service-account*.json
**/*-service-account*.json

*.pem
*.key
*.crt
*.p12
*.pfx


# ======================================================
# LOGS
# ======================================================

logs/
**/logs/

*.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ======================================================
# UPLOADS
# ======================================================

server/uploads/*
!server/uploads/.gitkeep

uploads/
**/uploads/
!**/uploads/.gitkeep


# ======================================================
# BUILD FILES
# ======================================================

dist/
**/dist/

build/
**/build/

client/dist/
server/dist/


# ======================================================
# CACHE
# ======================================================

.cache/
**/.cache/

.parcel-cache/
**/.parcel-cache/

.eslintcache

.npm/
.yarn/
.pnpm-store/


# ======================================================
# COVERAGE
# ======================================================

coverage/
**/coverage/

.nyc_output/


# ======================================================
# RUNTIME FILES
# ======================================================

*.pid
*.pid.lock
*.seed

*.sqlite
*.sqlite3
*.db


# ======================================================
# IDE FILES
# ======================================================

.vscode/
.idea/

*.swp
*.swo

*.code-workspace


# ======================================================
# OPERATING SYSTEM FILES
# ======================================================

.DS_Store
Thumbs.db
desktop.ini


# ======================================================
# TEMPORARY FILES
