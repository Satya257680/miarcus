# ======================================================
# DEPENDENCIES
# ======================================================

node_modules/
**/node_modules/

client/node_modules/
server/node_modules/


# ======================================================
# ENVIRONMENT VARIABLES / SECRETS
# ======================================================

.env
.env.*
**/.env
**/.env.*

/server/.env
/server/.env.*
/client/.env
/client/.env.*

.env.local
.env.development.local
.env.test.local
.env.production.local


# ======================================================
# GOOGLE OAUTH CREDENTIALS / TOKENS
# NEVER COMMIT THESE FILES
# ======================================================

credentials.json
**/credentials.json

gmail-token.json
**/gmail-token.json

token.json
**/token.json

client_secret*.json
**/client_secret*.json


# ======================================================
# PRIVATE KEYS / CERTIFICATES
# ======================================================

*.pem
*.key
*.crt


